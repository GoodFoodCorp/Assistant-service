PORT=8093
LOG_LEVEL=info
JWT_SECRET=YOUR_SECRET_KEY_HERE

# Laisser AI_BASE_URL vide pour tourner en mode démo hors-ligne (FakeProvider).
#
# Local (ex. Ollama, qui expose une API compatible OpenAI) :
#   AI_BASE_URL=http://ollama:11434/v1
#   AI_API_KEY=
#   AI_MODEL=llama3.1
#
# Cloud (ex. OpenAI) :
#   AI_BASE_URL=https://api.openai.com/v1
#   AI_API_KEY=sk-...
#   AI_MODEL=gpt-4o-mini
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
