PORT=8093
LOG_LEVEL=info
JWT_SECRET=YOUR_SECRET_KEY_HERE

# ── Fournisseur d'IA ─────────────────────────────────────────────────────────
# AI_PROVIDER choisit le fournisseur ; les clés restent côté serveur (jamais
# dans le navigateur). Laisser AI_PROVIDER et AI_BASE_URL vides pour tourner en
# mode démo hors-ligne (FakeProvider).
#
#   ollama | lmstudio                      local, pas de clé
#   openai | openrouter | groq | mistral
#   deepseek | together | gemini           cloud, AI_API_KEY obligatoire
#   anthropic                              cloud (API native Claude), AI_API_KEY obligatoire
#   openai-compatible                      tout autre endpoint compatible OpenAI (AI_BASE_URL requis)
#   demo                                   réponses factices, aucune IA
#
# AI_BASE_URL et AI_MODEL sont facultatifs : ils remplacent les valeurs par
# défaut du fournisseur (ex. un Ollama distant, un autre modèle).
# Sans AI_PROVIDER mais avec AI_BASE_URL : endpoint compatible OpenAI (ancienne
# configuration, inchangée).
#
# Exemples :
#   AI_PROVIDER=ollama          AI_MODEL=qwen2.5:7b
#   AI_PROVIDER=openai          AI_API_KEY=sk-...
#   AI_PROVIDER=anthropic       AI_API_KEY=sk-ant-...      AI_MODEL=claude-haiku-5-5
#   AI_PROVIDER=gemini          AI_API_KEY=...
#   AI_PROVIDER=openrouter      AI_API_KEY=sk-or-...       AI_MODEL=anthropic/claude-3.5-haiku
AI_PROVIDER=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Délai max d'une réponse. Un modèle local peut mettre bien plus longtemps au
# premier message (chargement en mémoire) : 120 est un bon réglage pour Ollama.
AI_TIMEOUT_SECONDS=60

# Where an admin-saved AI choice (provider/model/key) is stored; mount a volume here.
# AI_SETTINGS_FILE=/data/ai-settings.json
JWT_ISSUER=goodfood-auth
JWT_AUDIENCE=goodfood-api
